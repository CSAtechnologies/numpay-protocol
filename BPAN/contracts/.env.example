# ── Deployer ────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── RPC Endpoints ───────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Fresh Base deployment always starts at zero registration fee.
# Optional public address for an account-specific dry run without loading a key:
# BPAN_DEPLOYER_ADDRESS=0xYOUR_PUBLIC_ADDRESS
BPAN_DEPLOY_BROADCAST=false

# ── Etherscan Verification ──────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
