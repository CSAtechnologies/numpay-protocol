{
  "name": "numpay",
  "version": "0.1.0",
  "private": true,
  "description": "NumPay monorepo: shared core, browser extension, mobile app, wallet API worker",
  "workspaces": [
    "packages/*",
    "wallet-extension",
    "wallet-mobile"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build": "npm run build -w numpay-wallet",
    "test": "npm run test -w numpay-wallet",
    "typecheck": "tsc -p packages/core && tsc -p wallet-extension"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
