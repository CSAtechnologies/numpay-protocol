{
  "manifest_version": 3,
  "name": "NumPay",
  "version": "0.1.0",
  "description": "Multi-chain crypto wallet with BPAN support. Send crypto using simple account numbers.",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://*.g.alchemy.com/*",
    "https://*.drpc.org/*",
    "https://rpc.flashbots.net/*",
    "https://*.base.org/*",
    "https://*.linea.build/*",
    "https://*.scroll.io/*",
    "https://*.mantle.xyz/*",
    "https://*.blast.io/*",
    "https://*.fantom.network/*",
    "https://*.gnosischain.com/*",
    "https://*.moonbeam.network/*",
    "https://*.sei-apis.com/*",
    "https://*.zksync.io/*",
    "https://zkevm-rpc.com/*",
    "https://*.celo.org/*",
    "https://*.aurora.dev/*",
    "https://*.avax.network/*",
    "https://*.klaytn.net/*",
    "https://*.metis.io/*",
    "https://*.sui.io/*",
    "https://*.rpcpool.com/*",
    "https://*.nodeinfra.com/*",
    "https://*.helius-rpc.com/*",
    "https://xrplcluster.com/*",
    "https://*.trongrid.io/*",
    "https://blockstream.info/*",
    "https://litecoinspace.org/*",
    "https://aggregator-api.kyberswap.com/*",
    "https://*.paraswap.io/*",
    "https://li.quest/*",
    "https://*.relay.link/*",
    "https://*.jup.ag/*",
    "https://*.coingecko.com/*",
    "https://*.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://*.moralis.io/*",
    "https://*.covalenthq.com/*",
    "https://*.tronscanapi.com/*",
    "https://*.xrpscan.com/*",
    "https://*.etherscan.io/*",
    "https://*.polygonscan.com/*",
    "https://*.bscscan.com/*",
    "https://*.arbiscan.io/*",
    "https://*.basescan.org/*",
    "https://*.snowscan.xyz/*",
    "https://*.snowtrace.io/*",
    "https://*.celoscan.io/*",
    "https://*.cronoscan.com/*",
    "https://*.ftmscan.com/*",
    "https://*.gnosisscan.io/*",
    "https://*.moonscan.io/*",
    "https://*.blastscan.io/*",
    "https://*.scrollscan.com/*",
    "https://*.lineascan.build/*",
    "https://*.mantlescan.xyz/*",
    "https://*.seitrace.com/*",
    "https://flagcdn.com/*",
    "https://*.githubusercontent.com/*",
    "https://assets.coincap.io/*",
    "https://icons.llamao.fi/*",
    "https://cf-ipfs.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
