# Moralis Web3 API key (free Starter plan: https://admin.moralis.com)
# Used by src/lib/autoTokens.ts to auto-detect held ERC-20 tokens + USD prices
# on chains Alchemy doesn't cover (BSC, Avalanche, Fantom, etc.).
# Copy this file to .env and paste your key. .env is gitignored.
VITE_MORALIS_KEY=

# Alchemy API key (https://dashboard.alchemy.com). Public client key used for
# the default Ethereum/Polygon/Solana RPC endpoints in src/lib/networks.ts and
# token/history lookups. Restrict it by allowed origin in the Alchemy dashboard
# and use separate keys per environment. Without it, Alchemy-backed RPCs fail.
VITE_ALCHEMY_KEY=

# GoldRush (Covalent) API key (free tier: https://goldrush.dev). OPTIONAL.
# Fallback held-token + USD-price indexer (src/lib/autoTokens.ts Layer 4) so
# token detection survives Moralis running out of its daily quota. When empty,
# the GoldRush layer is simply skipped. Restrict by origin in the dashboard.
VITE_GOLDRUSH_KEY=

# Helius API key (https://dashboard.helius.dev). OPTIONAL. Preferred Solana
# mainnet RPC for balances and token reads (src/lib/chains/solana.ts). When set,
# it replaces the Alchemy Solana endpoint; when empty, Solana falls back to
# Alchemy. Restrict by allowed origin in the Helius dashboard.
VITE_HELIUS_KEY=

# NumPay wallet API proxy base URL (src/lib/walletApi.ts). OPTIONAL. When set,
# price reads (and later token reads) route through the proxy so provider
# quota is shared at the edge instead of per-install; any proxy failure falls
# back to the direct-key path above. Empty = call providers directly.
# Production: https://numpay-wallet-api.numpay.workers.dev
VITE_API_BASE=
