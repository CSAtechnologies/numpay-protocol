{
  "name": "numpay-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "NumPay — Multi-chain crypto wallet with BPAN support",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && vite build -c vite.config.inpage.ts && vite build -c vite.config.content.ts",
    "preview": "vite preview",
    "test:vectors": "node test/verify-address-vectors.mjs",
    "test:dapp": "node test/dapp-adversarial.mjs",
    "test": "node test/verify-address-vectors.mjs && node test/dapp-adversarial.mjs"
  },
  "dependencies": {
    "@bonfida/spl-name-service": "^3.0.23",
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.3.2",
    "@solana/web3.js": "^1.98.4",
    "bech32": "^2.0.0",
    "bs58": "^6.0.0",
    "ethers": "^6.9.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/chrome": "^0.0.260",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.3.0",
    "vite": "^5.2.0"
  }
