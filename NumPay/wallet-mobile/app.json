{
  "expo": {
    "name": "wallet-mobile",
    "slug": "wallet-mobile",
    "version": "1.0.0",
    "scheme": "numpay",
    "orientation": "portrait",
    "icon": "./assets/numpay-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#786EE9",
        "foregroundImage": "./assets/numpay-mark.png",
        "monochromeImage": "./assets/numpay-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.walletmobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "wc"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NumPay uses the camera only to scan WalletConnect QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0912",
          "image": "./assets/numpay-mark.png",
          "imageWidth": 150
        }
      ]
    ]
  }
}
